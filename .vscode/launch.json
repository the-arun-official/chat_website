{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/chat-backend",
            "console": "integratedTerminal",
            "env": {
                "NODE_OPTIONS": "--inspect"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Frontend in Chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/chat-frontend"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Practice Debugging",
            "program": "${workspaceFolder}/debug_practice.js",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": ["Debug Backend", "Launch Frontend in Chrome"]
        }
    ]
}