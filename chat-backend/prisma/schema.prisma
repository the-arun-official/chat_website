generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  PRIVATE
  GROUP
  CHANNEL
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  username       String    @unique
  fullName       String?
  avatarUrl      String?
  fcmToken       String?
  isVerified     Boolean   @default(false)
  isBot          Boolean   @default(false)
  status         UserStatus @default(OFFLINE)
  lastSeen       DateTime?
  preferredLanguage String   @default("en")
  knownLanguages    String[] @default(["en"])
  autoTranslate     Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  refreshTokens  RefreshToken[]
  chatParticipants ChatParticipant[]
  sentMessages     Message[]
  messageReceipts  MessageStatus[]
  notifications    Notification[]
  groupsCreated    Group[]
  savedMessages    SavedMessage[]
  reactions        Reaction[]
  contacts         Contact[] @relation("UserContacts")
  contactedBy      Contact[] @relation("ContactUsers")
  blockedUsers     BlockedUser[] @relation("Blocker")
  blockedBy        BlockedUser[] @relation("Blocked")
  reportsSubmitted Report[] @relation("Reporter")
  reportsReceived  Report[] @relation("ReportedUser")
  autoMessengerConfigs AutoMessengerConfig[]
  autoReplyRules       AutoReplyRule[]
  userAIProfile    UserAIProfile?
  pendingChatReply PendingChatReply?
  dailyStatus      DailyStatus?
  contactMemoriesOwned ContactMemory[] @relation("ContactMemoryOwner")
  contactMemoriesAbout ContactMemory[] @relation("ContactMemoryAbout")

  @@index([email])
  @@index([username])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Chat {
  id           String     @id @default(uuid())
  type         ChatType   @default(PRIVATE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  participants ChatParticipant[]
  messages     Message[]
  groupDetails Group?
  autoMessengerConfigs AutoMessengerConfig[]
  autoReplyRules       AutoReplyRule[] @relation("AutoReplyRules")

  @@index([type])
}

model Group {
  id          String   @id @default(uuid())
  chatId      String   @unique
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  name        String
  description String?
  avatarUrl   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([chatId])
}

model ChatParticipant {
  id        String          @id @default(uuid())
  chatId    String
  chat      Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ParticipantRole @default(MEMBER)
  isPinned  Boolean         @default(false)
  isArchived Boolean        @default(false)
  isMuted   Boolean         @default(false)
  unreadCount Int           @default(0)
  hasAccepted Boolean       @default(true)
  hiddenAt  DateTime?
  joinedAt  DateTime        @default(now())

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id              String      @id @default(uuid())
  chatId          String
  chat            Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type            MessageType @default(TEXT)
  content         String?     // Nullable because a message could just be an attachment
  parentMessageId String?
  parentMessage   Message?    @relation("ReplyTo", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         Message[]   @relation("ReplyTo")
  isDeleted       Boolean     @default(false)
  isEdited        Boolean     @default(false)
  detectedLanguage String?
  translations     Json?
  isAI             Boolean     @default(false)
  aiMetadata       Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  statuses        MessageStatus[]
  attachments     Attachment[]
  savedBy         SavedMessage[]
  reactions       Reaction[]

  @@index([chatId, createdAt])
  @@index([senderId])
}

model MessageStatus {
  id        String        @id @default(uuid())
  messageId String
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReceiptStatus @default(SENT)
  timestamp DateTime      @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId]) // A user can only have ONE emoji reaction per message
  @@index([messageId])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String   // e.g., 'image/png', 'video/mp4'
  fileSize  Int      // Size in bytes
  createdAt DateTime @default(now())

  @@index([messageId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g., 'NEW_MESSAGE', 'GROUP_INVITE'
  title     String
  body      String
  data      Json?    // Stores extra payload (like chatId, messageId)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ── V2 FEATURE EXTENSIONS ──

model SavedMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   User     @relation("ContactUsers", fields: [contactId], references: [id], onDelete: Cascade)
  alias     String?  // Optional nickname for the contact
  createdAt DateTime @default(now())

  @@unique([userId, contactId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId   String?  // Nullable if reporting a group instead of user
  reportedUser User?    @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: SetNull)
  chatId       String?  // The context chat where report occurred
  reason       String
  status       String   @default("PENDING") // PENDING, REVIEWED, RESOLVED
  createdAt    DateTime @default(now())
}

// ══════════════════════════════════════════════════════════════════
//  AI AUTO MESSENGER — SCHEMA ADDITIONS
// ══════════════════════════════════════════════════════════════════

enum AutoMessengerMode {
  FULL_AUTO
  SMART
  DRAFT_ONLY
}

enum PersonalityType {
  FRIENDLY
  PROFESSIONAL
  CASUAL
  FUNNY
  CORPORATE
  SUPPORTIVE
  ROMANTIC
  CUSTOM
}

enum MessageRisk {
  SAFE
  SCHEDULING
  MONEY
  COMMITMENT
  EMERGENCY
  SENSITIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CUSTOM_REPLIED
  EXPIRED
}

enum AutoReplyTriggerType {
  KEYWORD
  PATTERN
  TIME_BASED
}

enum AutoReplyResponseType {
  FIXED
  AI_ENHANCED
}

model AutoMessengerConfig {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId          String
  chat            Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  isEnabled       Boolean           @default(false)
  mode            AutoMessengerMode @default(SMART)
  personality     PersonalityType   @default(FRIENDLY)
  customPrompt    String?
  sleepStart      String?
  sleepEnd        String?
  timezone        String            @default("Asia/Kolkata")
  vipContacts     Json?             // JSON array of usernames ["user1", "user2"]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  approvals       ApprovalRequest[]

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model UserAIProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  styleFingerprint Json     @default("{}")
  lastLearnedAt    DateTime?
  aiProfileSetup   Boolean  @default(false)  // Tracks if owner profile (name, age, occupation) was set up
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── NEW: Pending Chat Reply (auto-reply for first-time contacts) ──
model PendingChatReply {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @default("Hey! 👋 Thanks for reaching out. The boss will get back to you soon!")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── NEW: Daily Status (status for today, resets at midnight) ──
model DailyStatus {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String?  // e.g., "on leave", "in meeting", empty if not set
  timezone  String   @default("Asia/Kolkata")
  date      DateTime // Date when status was set
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMemory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("ContactMemoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  contactId    String
  contact      User     @relation("ContactMemoryAbout", fields: [contactId], references: [id], onDelete: Cascade)
  memoryBlob   Json     @default("{}")
  summary      String?
  summaryAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, contactId])
  @@index([userId])
}

model ApprovalRequest {
  id            String             @id @default(uuid())
  configId      String
  config        AutoMessengerConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  userId        String
  chatId        String
  incomingMsg   String
  aiDraft       String
  riskType      MessageRisk
  confidence    Float
  status        ApprovalStatus     @default(PENDING)
  customReply   String?
  expiresAt     DateTime
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([userId, status])
  @@index([chatId])
}

model AIMessageLog {
  id           String      @id @default(uuid())
  userId       String
  chatId       String
  messageId    String?
  incomingMsg  String
  aiReply      String
  riskType     MessageRisk
  confidence   Float
  wasAutoSent  Boolean
  personality  PersonalityType
  language     String?
  source       String?
  processingMs Int?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([chatId])
  @@index([createdAt])
}

model AutoReplyRule {
  id                  String                @id @default(cuid())
  userId              String
  chatId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat                Chat                  @relation("AutoReplyRules", fields: [chatId], references: [id], onDelete: Cascade)
  triggerType         AutoReplyTriggerType
  triggerValue        String
  responseType        AutoReplyResponseType
  fixedResponse       String?
  aiPromptEnhancement String?
  enabled             Boolean               @default(true)
  caseSensitive       Boolean               @default(false)
  priority            Int                   @default(5)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([userId, chatId, triggerValue])
  @@index([userId])
  @@index([chatId])
}

